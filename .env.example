# Keep disabled until a dedicated Sweaply project is approved for connection.
SWEAPLY_SUPABASE_ENABLED=false
# Development UI previews only; ignored in production and when Supabase is enabled.
SWEAPLY_ENABLE_ACCOUNT_PREVIEW=false

# Supply values from the confirmed Sweaply Supabase project. No secrets belong here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact app origin; HTTPS in hosted environments, localhost allowed for local dev.
SITE_URL=
